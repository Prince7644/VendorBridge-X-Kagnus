{
  "name": "vendorbridge",
  "version": "1.0.0",
  "private": true,
  "description": "VendorBridge - Procurement & Vendor Management ERP (Week 1: Foundation & Vendor Management)",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "test": "npm test --prefix server",
    "lint": "npm run lint --prefix client",
    "seed": "npm run seed --prefix server",
    "create-admin": "npm run create-admin --prefix server"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
