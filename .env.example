# --- Server ---
NODE_ENV=development
PORT=5000
# Browser origin of the React app (used for CORS and password-reset links)
CLIENT_URL=http://localhost:5173

# --- Database ---
# Local:  mongodb://127.0.0.1:27017/vendorbridge
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vendorbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vendorbridge

# --- Sessions ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
SESSION_TTL_HOURS=8
# native (default, uses a MongoDB TTL index) or interval (for MongoDB-compatible servers without TTL support)
SESSION_AUTO_REMOVE=native

# --- Security tuning (optional) ---
AUTH_RATE_LIMIT_MAX=20
RESET_TOKEN_TTL_MINUTES=30

# --- Email (password reset). Leave EMAIL_HOST empty in development and the
# --- reset link is printed to the SERVER console instead of being emailed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="VendorBridge <no-reply@yourdomain.com>"

# --- Development seed (npm run seed) ---
SEED_PASSWORD=Demo@12345
